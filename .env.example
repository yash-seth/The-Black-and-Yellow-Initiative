# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> service_role (SERVER ONLY, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Map ----
# Default map center/zoom for the launch city (example: Bengaluru)
NEXT_PUBLIC_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_MAP_CENTER_LNG=77.5946
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
# Vector tile style. Default uses OpenFreeMap (no key). To use MapTiler instead,
# set this to https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---- hCaptcha ---- (https://dashboard.hcaptcha.com/)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# ---- Misc ----
# Public base URL of the deployed site (used for auth redirects, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the keep-alive GitHub Action sends to /api/health
HEALTH_PING_SECRET=change-me
